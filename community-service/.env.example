# Copy to .env and adjust values for your environment
SECRET_KEY=change-this-to-a-random-secret

# Database (SQLite in project folder)
# Default (recommended): leave DATABASE_URL unset to use data/community.db in this project.
# If set, file-based SQLite paths are normalized:
# - relative paths (e.g. sqlite:///data/community.db) are resolved relative to the project directory
# - absolute paths are honored (e.g. sqlite:///C:/path/to/community.db)
# - sqlite:///:memory: is supported for tests
# DATABASE_URL=sqlite:///data/community.db

# SMTP (optional - notifications are stored in outbox even if unset/unavailable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
